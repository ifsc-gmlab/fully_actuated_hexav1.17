<?xml version="1.0"?>
<model>
  <name>fully_actuated_hexa</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Custom PX4 GZ Sim integration</name>
  </author>
  <description>
    Six-motor fully-actuated hex for PX4 SITL Gazebo (gz sim).
    Hub poses preserved from the Classic import; MulticopterMotorModel
    plugins and onboard sensors follow typhoon_h480 / hex600 conventions.
    Run with: make px4_sitl gz_fully_actuated_hexa
  </description>
</model>
